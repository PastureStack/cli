#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/version"
cd "$(dirname "$0")/.."

declare -A OS_ARCH_ARG
OS_PLATFORM_ARG=(linux windows darwin)
OS_ARCH_ARG[linux]="amd64 arm"
OS_ARCH_ARG[windows]="386 amd64"
OS_ARCH_ARG[darwin]="amd64"

build_flags=(-trimpath -buildvcs=false -ldflags="-buildid= -s -w -X main.VERSION=${VERSION}")

mkdir -p bin
CGO_ENABLED=0 go build -mod=vendor "${build_flags[@]}" -o bin/pasturestack

if [ -n "${CROSS:-}" ]; then
    rm -rf build/bin
    mkdir -p build/bin
    for os_name in "${OS_PLATFORM_ARG[@]}"; do
        for architecture in ${OS_ARCH_ARG[${os_name}]}; do
            output="build/bin/pasturestack_${os_name}-${architecture}"
            if [ "${os_name}" = "windows" ]; then
                output="${output}.exe"
            fi
            printf 'Building binary for %s/%s...\n' "${os_name}" "${architecture}"
            GOARCH="${architecture}" GOOS="${os_name}" CGO_ENABLED=0 \
                go build -mod=vendor "${build_flags[@]}" -o "${output}" ./
        done
    done
fi
