#!/bin/bash
set -euo pipefail

restore_workspace_ownership()
{
    if [ -n "${DAPPER_UID:-}" ] && [ -n "${DAPPER_GID:-}" ]; then
        chown -R "${DAPPER_UID}:${DAPPER_GID}" . || true
    fi
}

trap restore_workspace_ownership EXIT

mkdir -p bin build/bin dist
if [ -e "./scripts/${1:-}" ]; then
    ./scripts/"$@"
else
    "$@"
fi
