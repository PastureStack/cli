#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo Running validation

PACKAGES=$(go list -mod=vendor ./...)

echo Running: go vet
go vet -mod=vendor ${PACKAGES}
echo Running: go fmt
test -z "$(find . -path ./vendor -prune -o -name '*.go' -type f -print0 | xargs -0 gofmt -l -s | tee /dev/stderr)"
